# BeltTrack Multi-Tenant Martial Arts Management Platform - Environment Template
# Transaction pooler URL (for runtime queries)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:6543/<DATABASE>?pgbouncer=true"
# Direct / Session pooler URL (for Prisma migrations & DDL)
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>"

# Supabase Auth & Public Client (Required for @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR-ANON-KEY>"

# Supabase Admin / Service Role (Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="<YOUR-SERVICE-ROLE-KEY>"

# Optional: New Supabase Key Formats (if using publishable/secret key architecture)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<YOUR-PUBLISHABLE-KEY>"
# SUPABASE_SECRET_KEY="<YOUR-SECRET-KEY>"
