datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  COACH
  STUDENT
  GUARDIAN
}

enum MembershipStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum DeletionTargetType {
  USER
  SCHOOL
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MANUAL_CARD
}

enum TransactionType {
  TUITION
  TESTING_FEE
  UNIFORM_EQUIPMENT
  CORRECTION_REVERSAL
}

enum TechniqueStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/**
 * Single-use, hashed verification and password-reset codes.
 * Auth infrastructure (like auth.sessions): looked up by normalized email because
 * codes are issued before/around tenant user provisioning. schoolId is populated
 * when the email already resolves to a tenant user so the record stays tenant-bound.
 */
model VerificationCode {
  id         String              @id @default(uuid())
  email      String
  schoolId   String?             @map("school_id")
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at")
  attempts   Int                 @default(0)
  used       Boolean             @default(false)
  lastSentAt DateTime            @default(now()) @map("last_sent_at")
  createdAt  DateTime            @default(now())

  @@index([email, purpose, used])
  @@index([schoolId])
  @@index([expiresAt])
}

model School {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  discipline           String
  city                 String
  country              String?
  timezone             String    @default("UTC")
  joinCode             String    @unique
  isCodeActive         Boolean   @default(true)
  deletionRequestedAt  DateTime? @map("deletion_requested_at")
  deletionScheduledFor DateTime? @map("deletion_scheduled_for")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users             User[]
  studentProfiles   StudentProfile[]
  guardianLinks     GuardianStudent[]
  rankTracks        RankTrack[]
  ranks             Rank[]
  techniques        Technique[]
  techniqueProgress TechniqueProgress[]
  classes           ClassSchedule[]
  attendances       Attendance[]
  ledger            LedgerEntry[]
  alerts            InactivityAlert[]
  receiptCounters   ReceiptCounter[]
  auditLogs         AuditLog[]

  @@index([joinCode])
  @@index([slug, city])
  @@index([deletionScheduledFor])
}

model User {
  id                    String           @id @default(uuid())
  supabaseUid           String?          @unique @map("supabase_uid")
  schoolId              String           @map("school_id")
  email                 String           @unique
  hashedPassword        String?
  role                  Role             @default(STUDENT)
  status                MembershipStatus @default(PENDING_APPROVAL)
  isEmailVerified       Boolean          @default(false) @map("email_verified")
  verificationCode      String?          @map("verification_code")
  verificationExpiresAt DateTime?        @map("verification_expires_at")
  deletionRequestedAt   DateTime?        @map("deletion_requested_at")
  deletionScheduledFor  DateTime?        @map("deletion_scheduled_for")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile       StudentProfile?
  guardianLinks GuardianStudent[] @relation("GuardianRelation")
  studentOf     GuardianStudent[] @relation("StudentRelation")
  auditLogs     AuditLog[]        @relation("AuditLogActor")

  @@index([schoolId, role])
  @@index([schoolId, status])
  @@index([status, deletionScheduledFor])
}

model StudentProfile {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  userId            String   @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  isMinor           Boolean  @default(false)
  currentRankId     String?
  lastPromotionDate DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRank       Rank?               @relation(fields: [currentRankId], references: [id])
  attendances       Attendance[]
  techniqueProgress TechniqueProgress[]

  @@index([schoolId])
}

model GuardianStudent {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  guardianId String
  studentId  String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian User   @relation("GuardianRelation", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User   @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([schoolId])
}

model RankTrack {
  id       String @id @default(uuid())
  schoolId String @map("school_id")
  name     String
  ranks    Rank[]
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Rank {
  id                 String @id @default(uuid())
  schoolId           String @map("school_id")
  rankTrackId        String
  orderIndex         Int
  title              String
  beltColorHex       String
  requiredClasses    Int
  requiredActiveDays Int

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rankTrack      RankTrack        @relation(fields: [rankTrackId], references: [id], onDelete: Cascade)
  techniques     Technique[]
  profilesAtRank StudentProfile[]

  @@unique([rankTrackId, orderIndex])
  @@index([schoolId])
}

model Technique {
  id          String  @id @default(uuid())
  schoolId    String  @map("school_id")
  rankId      String
  name        String
  description String?

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rank     Rank                @relation(fields: [rankId], references: [id], onDelete: Cascade)
  progress TechniqueProgress[]

  @@index([schoolId])
}

model TechniqueProgress {
  id          String          @id @default(uuid())
  schoolId    String          @map("school_id")
  profileId   String
  techniqueId String
  status      TechniqueStatus @default(NOT_STARTED)
  verifiedAt  DateTime?
  verifiedBy  String?

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  technique Technique      @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@unique([profileId, techniqueId])
  @@index([schoolId])
}

model ClassSchedule {
  id        String @id @default(uuid())
  schoolId  String @map("school_id")
  title     String
  weekday   Int
  startTime String
  endTime   String

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([schoolId])
}

model Attendance {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  idempotencyKey String
  profileId      String
  classId        String?
  attendedAt     DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile       StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  classSchedule ClassSchedule? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([profileId, attendedAt])
}

model LedgerEntry {
  id              String          @id @default(uuid())
  schoolId        String          @map("school_id")
  userId          String
  receiptSlug     String
  amountCents     Int
  currency        String          @default("USD")
  paymentMethod   PaymentMethod
  transactionType TransactionType
  reversalRefSlug String?
  note            String?
  createdAt       DateTime        @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptSlug])
  @@index([schoolId, userId])
  @@index([receiptSlug])
}

model InactivityAlert {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  profileId    String
  daysInactive Int
  isResolved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, profileId])
  @@index([schoolId, isResolved])
}

/**
 * Per-school, per-year, per-discipline receipt numbering.
 * The counter row is locked and incremented inside the ledger transaction so
 * receipt slugs remain unique without client-supplied numbering.
 */
model ReceiptCounter {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  year          Int
  discipline    String
  lastIncrement Int      @default(0) @map("last_increment")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year, discipline])
  @@index([schoolId])
}

/**
 * Account deletion workflow. Requests are deliberately not relation-cascaded so
 * the audit row survives the user or school purge. school_id remains the tenant
 * boundary; target_user_id is nullable for whole-school deletion requests.
 */
model DeletionRequest {
  id            String                @id @default(uuid())
  schoolId      String                @map("school_id")
  targetType    DeletionTargetType    @map("target_type")
  targetUserId  String?               @map("target_user_id")
  requestedById String?               @map("requested_by_id")
  reviewedById  String?               @map("reviewed_by_id")
  status        DeletionRequestStatus @default(PENDING)
  reason        String?
  decisionNote  String?               @map("decision_note")
  requestedAt   DateTime              @default(now()) @map("requested_at")
  reviewedAt    DateTime?             @map("reviewed_at")
  scheduledFor  DateTime?             @map("scheduled_for")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([status, scheduledFor])
  @@index([targetType, targetUserId])
}

model AuditLog {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, action])
}
