{
  "name": "belttrack-martial-arts",
  "version": "1.0.0",
  "description": "Private, multi-tenant martial arts school management & progress monitoring platform built with Next.js and strict design tokens",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "serve": "node server.js",
    "build:tokens": "node build-tokens.js",
    "audit": "node audit.js",
    "test:rate-limit": "node scripts/test-rate-limit.mjs",
    "test:email-verify": "node scripts/test-email-verification.mjs",
    "test:smtp": "node scripts/test-smtp-verification.mjs",
    "test:db-code": "node scripts/test-db-verification-code.mjs",
    "simulate:failures": "node scripts/simulate-verification-failures.mjs",
    "generate:contrast-pdf": "node scripts/generate-contrast-pdf.mjs",
    "benchmark:registration": "node scripts/benchmark-registration.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.4.3",
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3"
  }
}
