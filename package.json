{
  "name": "belttrack-martial-arts",
  "version": "1.0.0",
  "description": "Private, multi-tenant martial arts school management & progress monitoring platform built with Next.js and strict design tokens",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "serve": "node server.js",
    "build:tokens": "node build-tokens.js",
    "audit": "node audit.js",
    "test": "npm run test:unit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/schemas.test.mjs tests/tenant-isolation.test.mjs",
    "test:e2e": "playwright test",
    "test:rate-limit": "node scripts/test-rate-limit.mjs",
    "test:email-verify": "node scripts/test-email-verification.mjs",
    "test:smtp": "node scripts/test-smtp-verification.mjs",
    "test:db-code": "node scripts/test-db-verification-code.mjs",
    "simulate:failures": "node scripts/simulate-verification-failures.mjs",
    "generate:contrast-pdf": "node scripts/generate-contrast-pdf.mjs",
    "generate:account-deletion-pdf": "node scripts/generate-account-deletion-pdf.mjs",
    "generate:account-deletion-simulation-pdf": "node scripts/generate-account-deletion-simulation-pdf.mjs",
    "benchmark:registration": "node scripts/benchmark-registration.mjs",
    "profile:owner": "node scripts/launch-browser-profiles.mjs --role=owner",
    "profile:student": "node scripts/launch-browser-profiles.mjs --role=student",
    "profile:both": "node scripts/launch-browser-profiles.mjs --role=both",
    "db:generate": "prisma generate",
    "db:seed:demo": "node scripts/seed-demo-data.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.4.3",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3"
  }
}
